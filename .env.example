# העתיקי לקובץ .env ומלאי את המפתחות

# Google Cloud → APIs & Services → הפעילי "Places API (New)" → Credentials → API key
GOOGLE_MAPS_API_KEY=

# ספק ה-Dorking: serper (תוצאות גוגל אמיתיות) או brave
SEARCH_PROVIDER=serper
SERPER_API_KEY=
BRAVE_API_KEY=

# תקרות בקשות לכל חיפוש (הגנה על התקציב)
MAX_PLACES_REQUESTS=400
MAX_SEARCH_REQUESTS=150

# סריקה
CRAWL_CONCURRENCY=25
REQUEST_TIMEOUT=12
RESPECT_ROBOTS=1
# 1 = רינדור עמודי קריירה שבנויים ב-JavaScript (דורש playwright)
USE_PLAYWRIGHT=0
